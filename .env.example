# ===================================================
# ORESNA CAPTADOR — Variables de entorno
# Copia este archivo a .env y rellena tus valores
# ===================================================

# --- LLM Principal (elige uno) ---
# Opción A: OpenAI (recomendado para producción)
OPENAI_API_KEY=sk-...

# Opción B: Groq (gratuito, alto rendimiento)
GROQ_API_KEY=gsk_...

# Modelo a usar (cambia según el proveedor)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Para OpenAI usar: gpt-4o-mini

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=captacion@oresna.es
EMAIL_FROM_NAME=ORESNA Inmobiliaria

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/captador.db

# --- Configuración de la empresa ---
EMPRESA_NOMBRE=ORESNA Inmobiliaria
EMPRESA_ZONA=Navarra
EMPRESA_TELEFONO=+34 948 000 000
EMPRESA_WEB=https://www.oresna.es

# --- Scraping ---
SCRAPING_DELAY_SECONDS=2
SCRAPING_HEADLESS=true
MAX_CONTACTOS_POR_SESION=50

# --- Planificador ---
# Hora de ejecución diaria automática (formato HH:MM)
SCHEDULER_HORA=08:00
SCHEDULER_ACTIVO=false

# --- Modos ---
# development | production
APP_ENV=development
